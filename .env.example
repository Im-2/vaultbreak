# Copy to .env (gitignored) and fill in. Never commit real values.

# ---- Model provider (any OpenAI-compatible API). Leave all unset for the offline mock model. ----
# Option A (free, no card): Groq. Create a key at https://console.groq.com/keys
MODEL_PROVIDER=groq
MODEL_API_KEY=your-groq-key
# MODEL_BASE_URL=https://api.groq.com/openai/v1   # preset by MODEL_PROVIDER, override if needed
MODEL_NAME=openai/gpt-oss-120b
# MODEL_NAME_WEAK=openai/gpt-oss-20b              # optional per-guardian override: MODEL_NAME_<GUARDIAN_ID> (rogue defaults to qwen/qwen3.8-27b on groq)
# MODEL_TOOL_MODE=native                          # or "json" for models without native tool calling
# MODEL_MAX_TOKENS=300

# Option B: NEAR AI Cloud (needs credits). Required for the privacy/attestation layer.
# MODEL_PROVIDER=nearai
# MODEL_NAME=anthropic/claude-haiku-5-5
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1

# ---- NEAR / server ----
NEAR_RPC_URL=https://test.rpc.fastnear.com,https://near-testnet.drpc.org   # comma-separated = failover (rpc.testnet.near.org is deprecated and returns 429)
KEYS_DIR=./.keys
DB_PATH=./server/vaultbreak.db
PORT=8787
ADMIN_TOKEN=change-me
PROMPT_ENC_KEY=
OPERATOR_ACCOUNT_ID=your-operator.testnet
