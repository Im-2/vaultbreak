# Copy to .env (gitignored) and fill in. Never commit real values.
NEARAI_API_KEY=your-near-ai-cloud-key
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_MODEL=anthropic/claude-haiku-5-5
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# Guardian function-call private keys are stored under .keys/ (gitignored), referenced by key_ref.
OPERATOR_ACCOUNT_ID=your-operator.testnet
OPERATOR_PRIVATE_KEY=ed25519:placeholder
DB_PATH=./server/vaultbreak.db
PORT=8787
NEARAI_TOOL_MODE=native
ADMIN_TOKEN=change-me
KEYS_DIR=./.keys
PROMPT_ENC_KEY=
