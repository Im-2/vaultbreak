# Copy to .env (gitignored) and fill in. Never commit real values.
# With everything below left commented out the server uses the OFFLINE scripted "mock" model: it starts and passes its tests with no keys.

# ---- Model provider (any OpenAI-compatible API) ----
# Option A (free, no card): Groq. Create a key at https://console.groq.com/keys  (this is what the live demo uses)
# MODEL_PROVIDER=groq
# MODEL_API_KEY=your-groq-key
# MODEL_NAME=openai/gpt-oss-120b
# MODEL_BASE_URL=https://api.groq.com/openai/v1   # preset by MODEL_PROVIDER, override if needed
# MODEL_NAME_WEAK=openai/gpt-oss-20b              # optional per-guardian override: MODEL_NAME_<GUARDIAN_ID> (rogue defaults to qwen/qwen3.8-27b on groq)
# MODEL_TOOL_MODE=native                          # or "json" for models without native tool calling
# MODEL_MAX_TOKENS=300

# Option B: NEAR AI Cloud (needs credits; UNVERIFIED for signed exchanges here). Required for the privacy/attestation layer.
# MODEL_PROVIDER=nearai
# MODEL_NAME=anthropic/claude-haiku-5-5
# NEARAI_API_KEY=
# NEARAI_BASE_URL=https://cloud-api.near.ai/v1

# ---- NEAR / server (paths are relative to the repo root: start the server from there) ----
NEAR_RPC_URL=https://test.rpc.fastnear.com,https://near-testnet.drpc.org   # comma-separated = failover (rpc.testnet.near.org is deprecated and returns 429)
KEYS_DIR=./.keys
DB_PATH=./server/vaultbreak.db
PORT=8787
ADMIN_TOKEN=change-me
# PROMPT_ENC_KEY=          # optional; a key file is created in KEYS_DIR when unset
# OPERATOR_ACCOUNT_ID=your-operator.testnet

# Layer 2: record raw model exchanges for proofs. Automatic for MODEL_PROVIDER=nearai; set 1 to force for other providers.
# PRIVACY_CAPTURE=1

# Layer 3: the registry/factory contract that mints NFT guardians (enables POST /guardians/prepare).
# The LIVE demo uses (see deployments/ and GET /config on the live backend):
# REGISTRY_ACCOUNT_ID=registry.vbreak-t2funder-1109.testnet
# Layer 4: the swarm pool contract (enables /pools endpoints). Live demo:
# POOL_ACCOUNT_ID=pool.vbreak-t2funder-1109.testnet

# ---- Public deployment (see render.yaml, docs/hosting.md). All optional locally. ----
# PUBLIC_BASE_URL=https://tryvaultbreak.vercel.app   # every NFT reference/image link and the CORS allow-list use this
# RL_PER_MINUTE=240 RL_CHAT_PER_MINUTE=12 RL_CHAT_PER_DAY=150 RL_SIGNIN_PER_HOUR=30 RL_ACCOUNTS_PER_IP_HOUR=6 MODEL_DAILY_CAP=1500 MESSAGE_MAX_CHARS=1000   # abuse limits (defaults shown)
# BLOB_READ_WRITE_TOKEN=     # Vercel Blob: metadata/image snapshots and the encrypted state backup
# BACKUP_PASSPHRASE=         # encrypts/decrypts that backup (AES-256-GCM)
# TESTNET_FUNDER_KEY=        # secret key of the faucet account that funds play accounts (testnet-stack.ts only)
# VAULT_READ_CACHE_MS=5000   # how long a vault read is reused (0 = off)
# SESSION_SWEEP=off          # disable the expired-session cleanup job

# Web UI demo stack (npm run dev): uses MODEL_* above for live chat; leave them unset for the scripted offline model.
