{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/stats",
      "destination": "/api/snap?what=stats"
    },
    {
      "source": "/api/guardians",
      "destination": "/api/snap?what=guardians"
    },
    {
      "source": "/api/guardians/:id/image.svg",
      "destination": "/api/image?id=:id"
    },
    {
      "source": "/api/guardians/:id/metadata.json",
      "destination": "/api/metadata?id=:id"
    },
    {
      "source": "/api/:path*",
      "destination": "https://vaultbreak-backend-x6zt.onrender.com/:path*"
    },
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
