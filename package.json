{
  "name": "vaultbreak",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "workspaces": ["tests", "server", "sdk"],
  "scripts": {
    "build:contracts": "bash scripts/build-contracts.sh",
    "test:contracts": "cargo test -p vaultbreak-vault -p vaultbreak-registry",
    "test:sandbox": "npm -w tests test",
    "test:server": "npm -w server test",
    "demo": "node --import tsx scripts/redteam-demo.ts",
    "demo:privacy": "node --import tsx scripts/privacy-demo.ts",
    "demo:nft": "node --import tsx scripts/nft-demo.ts",
    "test": "npm run test:contracts && npm run test:sandbox && npm run test:server"
  }
}
